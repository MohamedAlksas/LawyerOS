datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  MAINTAINER
}

model User {
  id                String       @id
  name              String
  email             String       @unique
  emailVerified     Boolean      @default(false)
  image             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  role              UserRole     @default(OWNER)
  twoFactorEnabled  Boolean?     @default(false)
  credentialVersion Int          @default(1)
  sessions          Session[]
  accounts          Account[]
  twoFactors        TwoFactor[]

  @@map("user")
}

model Session {
  id                String   @id
  expiresAt         DateTime
  token             String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ipAddress         String?
  userAgent         String?
  userId            String
  credentialVersion Int      @default(1)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("twoFactor")
}

model OfficeBootstrap {
  id       String   @id @default("singleton")
  isClosed Boolean  @default(true)
  closedAt DateTime @default(now())
  ownerId  String

  @@map("office_bootstrap")
}

enum PartyKind {
  PERSON
  ORGANIZATION
}

enum IdentificationType {
  NATIONAL_ID
  PASSPORT
  COMMERCIAL_REG
  TAX_CARD
  OTHER
}

enum CommunicationChannel {
  PHONE
  IN_PERSON
  WHATSAPP
  EMAIL
  OTHER
}

enum PoAType {
  GENERAL
  SPECIAL
  LITIGATION
  COMMERCIAL
  OTHER
}

enum PoAReviewStatus {
  UNREVIEWED
  VALID
  EXPIRED
  REVOKED
  DEFECTIVE
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model Party {
  id                      String              @id @default(uuid())
  kind                    PartyKind
  name                    String
  nameNormalized          String
  primaryPhone            String?
  primaryPhoneNormalized  String?
  additionalPhones        String[]            @default([])
  email                   String?
  address                 String?
  notes                   String?
  archivedAt              DateTime?           @db.Timestamptz(3)
  version                 Int                 @default(1)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  createdById             String
  updatedById             String

  identities              PartyIdentity[]
  communicationNotes      CommunicationNote[]
  powersOfAttorney        PowerOfAttorney[]
  matterParties           MatterParty[]

  @@index([nameNormalized])
  @@index([primaryPhoneNormalized])
  @@index([archivedAt])
  @@map("party")
}

model PartyIdentity {
  id                 String             @id @default(uuid())
  partyId            String
  identificationType IdentificationType
  ciphertext         String             // Base64 encoded encrypted payload
  iv                 String             // Base64 encoded 12-byte initialization vector
  authTag            String             // Base64 encoded 16-byte authentication tag
  keyId              String
  encryptionVersion  Int                @default(1)
  lastFour           String             // Trailing 4 digits for display masking
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  createdById        String

  party              Party              @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_identity")
}

model CommunicationNote {
  id                 String               @id @default(uuid())
  partyId            String
  matterId           String?              // Optional reference reserved for T06; unlinked in T05
  communicationAt    DateTime             @db.Timestamptz(3) // Absolute instant (timestamptz)
  channel            CommunicationChannel
  summary            String
  followUpRequired   Boolean              @default(false)
  followUpDate       DateTime?            @db.Date // Date-only representation for follow up
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  createdById        String

  party              Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, communicationAt])
  @@map("communication_note")
}

model PowerOfAttorney {
  id                 String          @id @default(uuid())
  partyId            String
  poaNumberText      String          // Case/record number preserving leading zeros
  poaYearLabel       String          // e.g. "2026"
  notarizationOffice String          // Issuing Real Estate Registration / Notarization office
  poaType            PoAType
  issueDate          DateTime?       @db.Date // Date-only stored as calendar day
  humanReviewStatus  PoAReviewStatus @default(UNREVIEWED)
  humanReviewedAt    DateTime?       @db.Timestamptz(3)
  humanReviewedById  String?
  notes              String?
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  createdById        String
  updatedById        String

  party              Party           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  matterAuthorizations MatterAuthorization[]

  @@index([partyId])
  @@index([poaNumberText, poaYearLabel])
  @@map("power_of_attorney")
}

model AuditEvent {
  id                 String   @id @default(uuid())
  userId             String
  action             String   // e.g. "CREATE_PARTY", "UPDATE_PARTY", "REVEAL_IDENTITY"
  entityType         String   // e.g. "Party", "PartyIdentity"
  entityId           String
  changedFields      Json?    // Redacted payload changes (never full identity, never keys)
  reason             String?
  requestId          String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_event")
}

model IdempotencyRecord {
  id                 String            @id @default(uuid())
  actorId            String
  commandType        String            // e.g. "saveParty", "savePowerOfAttorney"
  key                String
  payloadHash        String            // Scoped payload digest with a version prefix when keyed
  status             IdempotencyStatus @default(IN_PROGRESS)
  resultType         String?
  resultId           String?
  resultPayload      Json?             // Redacted result summary (never raw secrets)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?         @db.Timestamptz(3)

  @@unique([actorId, commandType, key])
  @@index([createdAt])
  @@map("idempotency_record")
}

enum MatterKind {
  LITIGATION
  CONSULTATION
  CONTRACT
  OTHER
}

enum MatterStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum MatterPartyRole {
  CLIENT
  OPPONENT
  OTHER
}

enum ProceedingInstance {
  FIRST_INSTANCE
  APPEAL
  CASSATION
  OTHER
}

enum ProceedingStatus {
  DRAFT
  ACTIVE
  AWAITING_JUDGMENT
  DECIDED
  CLOSED
}

enum ProceedingLegalCapacity {
  PLAINTIFF
  DEFENDANT
  APPELLANT
  APPELLEE
  INTERVENOR
  OTHER
}

enum ReferenceItemType {
  COURT
  PRACTICE_AREA
  STORAGE_LOCATION
}

model Matter {
  id              String            @id @default(uuid())
  fileCode        String            @unique
  title           String
  titleNormalized String?
  kind            MatterKind
  status          MatterStatus      @default(DRAFT)
  practiceAreaId  String?
  openingDate     DateTime?         @db.Date
  closingDate     DateTime?         @db.Date
  summary         String?
  notes           String?
  paperLocationId String?
  archivedAt      DateTime?         @db.Timestamptz(3)
  archiveReason   String?
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdById     String
  updatedById     String

  practiceArea    PracticeArea?     @relation(fields: [practiceAreaId], references: [id])
  paperLocation   StorageLocation?  @relation(fields: [paperLocationId], references: [id])
  parties         MatterParty[]
  proceedings     Proceeding[]
  authorizations  MatterAuthorization[]
  tasks           Task[]
  deadlines       Deadline[]
  noteRevisions   MatterNoteRevision[]

  @@index([status])
  @@index([status, updatedAt])
  @@index([archivedAt])
  @@index([kind])
  @@index([practiceAreaId])
  @@index([paperLocationId])
  @@index([titleNormalized])
  @@map("matter")
}

model MatterNoteRevision {
  id          String   @id @default(uuid())
  matterId    String
  version     Int
  notes       String?
  changedById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@unique([matterId, version])
  @@map("matter_note_revision")
}

model MatterParty {
  id                String            @id @default(uuid())
  matterId          String
  partyId           String
  role              MatterPartyRole
  isPrimaryContact  Boolean           @default(false)
  billingEnabled    Boolean           @default(false)
  notes             String?
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  createdById       String
  updatedById       String

  matter            Matter            @relation(fields: [matterId], references: [id], onDelete: Cascade)
  party             Party             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  proceedingParties ProceedingParty[]

  @@unique([matterId, partyId, role])
  @@index([partyId])
  @@index([matterId])
  @@map("matter_party")
}

model Proceeding {
  id                 String             @id @default(uuid())
  matterId           String
  courtId            String
  instance           ProceedingInstance
  parentProceedingId String?
  registerType       String?
  circuit            String?
  numberText         String?
  numberNormalized   String?
  yearLabel          String?
  yearNormalized     String?
  filingDate         DateTime?          @db.Date
  claimAmount        String?
  status             ProceedingStatus   @default(DRAFT)
  archivedAt         DateTime?          @db.Timestamptz(3)
  archiveReason      String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  createdById        String
  updatedById        String

  matter             Matter             @relation(fields: [matterId], references: [id], onDelete: Cascade)
  court              Court              @relation(fields: [courtId], references: [id])
  parentProceeding   Proceeding?        @relation("ProceedingHierarchy", fields: [parentProceedingId], references: [id])
  childProceedings   Proceeding[]       @relation("ProceedingHierarchy")
  parties            ProceedingParty[]
  hearings           Hearing[]
  tasks              Task[]
  deadlines          Deadline[]

  @@index([matterId])
  @@index([courtId])
  @@index([parentProceedingId])
  @@index([numberText, yearLabel])
  @@index([numberNormalized, yearLabel])
  @@index([courtId, numberNormalized])
  @@index([archivedAt])
  @@map("proceeding")
}

model ProceedingParty {
  id            String                   @id @default(uuid())
  proceedingId  String
  matterPartyId String
  capacityText  String                   @db.VarChar(100)
  legalCapacity ProceedingLegalCapacity?
  notes         String?
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  createdById   String

  proceeding    Proceeding               @relation(fields: [proceedingId], references: [id], onDelete: Cascade)
  matterParty   MatterParty              @relation(fields: [matterPartyId], references: [id], onDelete: Cascade)

  @@unique([proceedingId, matterPartyId])
  @@index([matterPartyId])
  @@map("proceeding_party")
}

model MatterAuthorization {
  id                String          @id @default(uuid())
  matterId          String
  powerOfAttorneyId String
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  createdById       String

  matter            Matter          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  powerOfAttorney   PowerOfAttorney @relation(fields: [powerOfAttorneyId], references: [id], onDelete: Cascade)

  @@unique([matterId, powerOfAttorneyId])
  @@index([powerOfAttorneyId])
  @@map("matter_authorization")
}

model OfficeSettings {
  id          String   @id @default("singleton")
  officeName  String
  lawyerName  String?
  phone       String?
  email       String?
  address     String?
  taxNumber   String?
  currency    String   @default("EGP")
  timeZone    String   @default("Africa/Cairo")
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String

  @@map("office_settings")
}

model Court {
  id           String       @id @default(uuid())
  name         String
  code         String?
  circuitTypes String[]     @default([])
  notes        String?
  isActive     Boolean      @default(true)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  createdById  String
  updatedById  String

  proceedings  Proceeding[]

  @@index([isActive, name])
  @@map("court")
}

model PracticeArea {
  id          String   @id @default(uuid())
  name        String
  code        String?
  notes       String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String
  updatedById String

  matters     Matter[]

  @@index([isActive, name])
  @@map("practice_area")
}

model StorageLocation {
  id          String   @id @default(uuid())
  name        String
  code        String?
  notes       String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String
  updatedById String

  matters     Matter[]

  @@index([isActive, name])
  @@map("storage_location")
}

model FileCodeSequence {
  year      Int      @id
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("file_code_sequence")
}

enum HearingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum NextDateDisposition {
  KNOWN
  NONE
  UNDETERMINED
}

enum HearingLinkRelation {
  ADJOURNED_TO
  RESCHEDULED_TO
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DeadlineStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum JobType {
  REMINDER_DELIVERY
}

enum JobRunStatus {
  PENDING
  CANCELLED
}

model Hearing {
  id                   String         @id @default(uuid())
  proceedingId         String         @map("proceeding_id")
  hearingDate          DateTime       @db.Date @map("hearing_date")
  hearingTime          String?        @map("hearing_time")
  courtHall            String?        @map("court_hall")
  purpose              String?        @map("purpose")
  rollNumber           String?        @map("roll_number")
  status               HearingStatus  @default(SCHEDULED) @map("status")
  version              Int            @default(1) @map("version")
  rescheduleReason     String?        @map("reschedule_reason")
  cancellationReason   String?        @map("cancellation_reason")
  supersedesHearingId  String?        @map("supersedes_hearing_id")
  createdAt            DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById          String         @map("created_by_id")
  updatedById          String         @map("updated_by_id")

  proceeding           Proceeding     @relation(fields: [proceedingId], references: [id], onDelete: Cascade)
  results              HearingResult[]
  tasks                Task[]
  linksFrom            HearingLink[]  @relation("HearingLinksFrom")
  linksTo              HearingLink[]  @relation("HearingLinksTo")
  supersededBy         Hearing[]      @relation("HearingSupersedes")
  supersedesHearing    Hearing?       @relation("HearingSupersedes", fields: [supersedesHearingId], references: [id])

  @@index([proceedingId, hearingDate])
  @@index([status, hearingDate])
  @@index([hearingDate])
  @@map("hearing")
}

model HearingResult {
  id                   String              @id @default(uuid())
  hearingId            String              @map("hearing_id")
  decisionText         String              @map("decision_text")
  summary              String?             @map("summary")
  attendance           String?             @map("attendance")
  notes                String?             @map("notes")
  correctionReason     String?             @map("correction_reason")
  nextDateDisposition  NextDateDisposition @map("next_date_disposition")
  recordedAt           DateTime            @db.Timestamptz(3) @map("recorded_at")
  revision             Int                 @default(1) @map("revision")
  supersedesResultId   String?             @map("supersedes_result_id")
  createdAt            DateTime            @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById          String              @map("created_by_id")
  updatedById          String              @map("updated_by_id")

  hearing              Hearing             @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  supersededBy         HearingResult[]     @relation("HearingResultSupersedes")
  supersedesResult     HearingResult?      @relation("HearingResultSupersedes", fields: [supersedesResultId], references: [id])

  @@index([hearingId])
  @@unique([hearingId, revision])
  @@map("hearing_result")
}

model HearingLink {
  id             String              @id @default(uuid())
  fromHearingId  String              @map("from_hearing_id")
  toHearingId    String              @map("to_hearing_id")
  relation       HearingLinkRelation @map("relation")
  createdAt      DateTime            @default(now()) @db.Timestamptz(3) @map("created_at")
  createdById    String              @map("created_by_id")

  fromHearing    Hearing             @relation("HearingLinksFrom", fields: [fromHearingId], references: [id], onDelete: Cascade)
  toHearing      Hearing             @relation("HearingLinksTo", fields: [toHearingId], references: [id], onDelete: Cascade)

  @@unique([fromHearingId, toHearingId, relation])
  @@index([fromHearingId])
  @@index([toHearingId])
  @@map("hearing_link")
}

model Task {
  id            String       @id @default(uuid())
  matterId      String?      @map("matter_id")
  proceedingId  String?      @map("proceeding_id")
  hearingId     String?      @map("hearing_id")
  deadlineId    String?      @map("deadline_id")
  title         String       @map("title")
  details       String?      @map("details")
  dueDate       DateTime?    @db.Date @map("due_date")
  dueTime       String?      @map("due_time")
  priority      TaskPriority @default(NORMAL) @map("priority")
  status        TaskStatus   @default(OPEN) @map("status")
  completedAt   DateTime?    @db.Timestamptz(3) @map("completed_at")
  completedById String?      @map("completed_by_id")
  version       Int          @default(1) @map("version")
  createdAt     DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById   String       @map("created_by_id")
  updatedById   String       @map("updated_by_id")

  matter        Matter?      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  proceeding    Proceeding?  @relation(fields: [proceedingId], references: [id], onDelete: SetNull)
  hearing       Hearing?     @relation(fields: [hearingId], references: [id], onDelete: SetNull)
  deadline      Deadline?    @relation(fields: [deadlineId], references: [id], onDelete: SetNull)

  @@index([matterId, status])
  @@index([status, dueDate])
  @@index([proceedingId])
  @@index([hearingId])
  @@index([deadlineId])
  @@map("task")
}

model Deadline {
  id                    String         @id @default(uuid())
  matterId              String         @map("matter_id")
  proceedingId          String?        @map("proceeding_id")
  title                 String         @map("title")
  dueDate               DateTime?      @db.Date @map("due_date")
  dueTime               String?        @map("due_time")
  source                String?        @map("source")
  basisNotes            String?        @map("basis_notes")
  sourceDocumentId      String?        @map("source_document_id")
  status                DeadlineStatus @default(DRAFT) @map("status")
  confirmedAt           DateTime?      @db.Timestamptz(3) @map("confirmed_at")
  confirmedById         String?        @map("confirmed_by_id")
  confirmedByName       String?        @map("confirmed_by_name")
  dateChangeReason      String?        @map("date_change_reason")
  completionDescription String?        @map("completion_description")
  completedDate         DateTime?      @db.Date @map("completed_date")
  completedAt           DateTime?      @db.Timestamptz(3) @map("completed_at")
  completedById         String?        @map("completed_by_id")
  cancellationReason    String?        @map("cancellation_reason")
  cancelledAt           DateTime?      @db.Timestamptz(3) @map("cancelled_at")
  version               Int            @default(1) @map("version")
  createdAt             DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById           String         @map("created_by_id")
  updatedById           String         @map("updated_by_id")

  matter                Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  proceeding            Proceeding?    @relation(fields: [proceedingId], references: [id], onDelete: SetNull)
  tasks                 Task[]

  @@index([status, dueDate])
  @@index([matterId, status])
  @@index([proceedingId, status])
  @@map("deadline")
}

model JobRun {
  id               String       @id @default(uuid())
  jobType          JobType      @default(REMINDER_DELIVERY) @map("job_type")
  sourceType       String       @default("Hearing") @map("source_type")
  sourceId         String       @map("source_id")
  scheduledAt      DateTime     @db.Timestamptz(3) @map("scheduled_at")
  status           JobRunStatus @default(PENDING) @map("status")
  deduplicationKey String       @unique @map("deduplication_key")
  payload          Json         @map("payload")
  createdAt        DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@index([sourceType, sourceId, status])
  @@index([status, scheduledAt])
  @@map("job_run")
}
