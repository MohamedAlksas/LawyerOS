datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  MAINTAINER
}

model User {
  id                String       @id
  name              String
  email             String       @unique
  emailVerified     Boolean      @default(false)
  image             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  role              UserRole     @default(OWNER)
  twoFactorEnabled  Boolean?     @default(false)
  credentialVersion Int          @default(1)
  sessions          Session[]
  accounts          Account[]
  twoFactors        TwoFactor[]

  @@map("user")
}

model Session {
  id                String   @id
  expiresAt         DateTime
  token             String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ipAddress         String?
  userAgent         String?
  userId            String
  credentialVersion Int      @default(1)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("twoFactor")
}

model OfficeBootstrap {
  id       String   @id @default("singleton")
  isClosed Boolean  @default(true)
  closedAt DateTime @default(now())
  ownerId  String

  @@map("office_bootstrap")
}

enum PartyKind {
  PERSON
  ORGANIZATION
}

enum IdentificationType {
  NATIONAL_ID
  PASSPORT
  COMMERCIAL_REG
  TAX_CARD
  OTHER
}

enum CommunicationChannel {
  PHONE
  IN_PERSON
  WHATSAPP
  EMAIL
  OTHER
}

enum PoAType {
  GENERAL
  SPECIAL
  LITIGATION
  COMMERCIAL
  OTHER
}

enum PoAReviewStatus {
  UNREVIEWED
  VALID
  EXPIRED
  REVOKED
  DEFECTIVE
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model Party {
  id                      String              @id @default(uuid())
  kind                    PartyKind
  name                    String
  nameNormalized          String
  primaryPhone            String?
  primaryPhoneNormalized  String?
  additionalPhones        String[]            @default([])
  email                   String?
  address                 String?
  notes                   String?
  archivedAt              DateTime?           @db.Timestamptz(3)
  version                 Int                 @default(1)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  createdById             String
  updatedById             String

  identities              PartyIdentity[]
  communicationNotes      CommunicationNote[]
  powersOfAttorney        PowerOfAttorney[]
  matterParties           MatterParty[]
  documents               Document[]

  @@index([nameNormalized])
  @@index([primaryPhoneNormalized])
  @@index([archivedAt])
  @@map("party")
}

model PartyIdentity {
  id                 String             @id @default(uuid())
  partyId            String
  identificationType IdentificationType
  ciphertext         String             // Base64 encoded encrypted payload
  iv                 String             // Base64 encoded 12-byte initialization vector
  authTag            String             // Base64 encoded 16-byte authentication tag
  keyId              String
  encryptionVersion  Int                @default(1)
  lastFour           String             // Trailing 4 digits for display masking
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  createdById        String

  party              Party              @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_identity")
}

model CommunicationNote {
  id                 String               @id @default(uuid())
  partyId            String
  matterId           String?              // Optional reference reserved for T06; unlinked in T05
  communicationAt    DateTime             @db.Timestamptz(3) // Absolute instant (timestamptz)
  channel            CommunicationChannel
  summary            String
  followUpRequired   Boolean              @default(false)
  followUpDate       DateTime?            @db.Date // Date-only representation for follow up
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  createdById        String

  party              Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, communicationAt])
  @@map("communication_note")
}

model PowerOfAttorney {
  id                 String          @id @default(uuid())
  partyId            String
  poaNumberText      String          // Case/record number preserving leading zeros
  poaYearLabel       String          // e.g. "2026"
  notarizationOffice String          // Issuing Real Estate Registration / Notarization office
  poaType            PoAType
  issueDate          DateTime?       @db.Date // Date-only stored as calendar day
  humanReviewStatus  PoAReviewStatus @default(UNREVIEWED)
  humanReviewedAt    DateTime?       @db.Timestamptz(3)
  humanReviewedById  String?
  notes              String?
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  createdById        String
  updatedById        String

  party              Party           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  matterAuthorizations MatterAuthorization[]

  @@index([partyId])
  @@index([poaNumberText, poaYearLabel])
  @@map("power_of_attorney")
}

model AuditEvent {
  id                 String   @id @default(uuid())
  userId             String
  action             String   // e.g. "CREATE_PARTY", "UPDATE_PARTY", "REVEAL_IDENTITY"
  entityType         String   // e.g. "Party", "PartyIdentity"
  entityId           String
  changedFields      Json?    // Redacted payload changes (never full identity, never keys)
  reason             String?
  requestId          String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_event")
}

model IdempotencyRecord {
  id                 String            @id @default(uuid())
  actorId            String
  commandType        String            // e.g. "saveParty", "savePowerOfAttorney"
  key                String
  payloadHash        String            // Scoped payload digest with a version prefix when keyed
  status             IdempotencyStatus @default(IN_PROGRESS)
  resultType         String?
  resultId           String?
  resultPayload      Json?             // Redacted result summary (never raw secrets)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?         @db.Timestamptz(3)

  @@unique([actorId, commandType, key])
  @@index([createdAt])
  @@map("idempotency_record")
}

enum MatterKind {
  LITIGATION
  CONSULTATION
  CONTRACT
  OTHER
}

enum MatterStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum MatterPartyRole {
  CLIENT
  OPPONENT
  OTHER
}

enum ProceedingInstance {
  FIRST_INSTANCE
  APPEAL
  CASSATION
  OTHER
}

enum ProceedingStatus {
  DRAFT
  ACTIVE
  AWAITING_JUDGMENT
  DECIDED
  CLOSED
}

enum ProceedingLegalCapacity {
  PLAINTIFF
  DEFENDANT
  APPELLANT
  APPELLEE
  INTERVENOR
  OTHER
}

enum ReferenceItemType {
  COURT
  PRACTICE_AREA
  STORAGE_LOCATION
}

model Matter {
  id              String            @id @default(uuid())
  fileCode        String            @unique
  title           String
  titleNormalized String?
  kind            MatterKind
  status          MatterStatus      @default(DRAFT)
  practiceAreaId  String?
  openingDate     DateTime?         @db.Date
  closingDate     DateTime?         @db.Date
  summary         String?
  notes           String?
  paperLocationId String?
  archivedAt      DateTime?         @db.Timestamptz(3)
  archiveReason   String?
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdById     String
  updatedById     String

  practiceArea    PracticeArea?     @relation(fields: [practiceAreaId], references: [id])
  paperLocation   StorageLocation?  @relation(fields: [paperLocationId], references: [id])
  parties         MatterParty[]
  proceedings     Proceeding[]
  authorizations  MatterAuthorization[]
  tasks           Task[]
  deadlines       Deadline[]
  noteRevisions   MatterNoteRevision[]
  reminderDeliveries ReminderDelivery[]
  documents       Document[]

  @@index([status])
  @@index([status, updatedAt])
  @@index([archivedAt])
  @@index([kind])
  @@index([practiceAreaId])
  @@index([paperLocationId])
  @@index([titleNormalized])
  @@map("matter")
}

model MatterNoteRevision {
  id          String   @id @default(uuid())
  matterId    String
  version     Int
  notes       String?
  changedById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@unique([matterId, version])
  @@map("matter_note_revision")
}

model MatterParty {
  id                String            @id @default(uuid())
  matterId          String
  partyId           String
  role              MatterPartyRole
  isPrimaryContact  Boolean           @default(false)
  billingEnabled    Boolean           @default(false)
  notes             String?
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  createdById       String
  updatedById       String

  matter            Matter            @relation(fields: [matterId], references: [id], onDelete: Cascade)
  party             Party             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  proceedingParties ProceedingParty[]

  @@unique([matterId, partyId, role])
  @@index([partyId])
  @@index([matterId])
  @@map("matter_party")
}

model Proceeding {
  id                 String             @id @default(uuid())
  matterId           String
  courtId            String
  instance           ProceedingInstance
  parentProceedingId String?
  registerType       String?
  circuit            String?
  numberText         String?
  numberNormalized   String?
  yearLabel          String?
  yearNormalized     String?
  filingDate         DateTime?          @db.Date
  claimAmount        String?
  status             ProceedingStatus   @default(DRAFT)
  archivedAt         DateTime?          @db.Timestamptz(3)
  archiveReason      String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  createdById        String
  updatedById        String

  matter             Matter             @relation(fields: [matterId], references: [id], onDelete: Cascade)
  court              Court              @relation(fields: [courtId], references: [id])
  parentProceeding   Proceeding?        @relation("ProceedingHierarchy", fields: [parentProceedingId], references: [id])
  childProceedings   Proceeding[]       @relation("ProceedingHierarchy")
  parties            ProceedingParty[]
  hearings           Hearing[]
  tasks              Task[]
  deadlines          Deadline[]
  documents          Document[]

  @@index([matterId])
  @@index([courtId])
  @@index([parentProceedingId])
  @@index([numberText, yearLabel])
  @@index([numberNormalized, yearLabel])
  @@index([courtId, numberNormalized])
  @@index([archivedAt])
  @@map("proceeding")
}

model ProceedingParty {
  id            String                   @id @default(uuid())
  proceedingId  String
  matterPartyId String
  capacityText  String                   @db.VarChar(100)
  legalCapacity ProceedingLegalCapacity?
  notes         String?
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  createdById   String

  proceeding    Proceeding               @relation(fields: [proceedingId], references: [id], onDelete: Cascade)
  matterParty   MatterParty              @relation(fields: [matterPartyId], references: [id], onDelete: Cascade)

  @@unique([proceedingId, matterPartyId])
  @@index([matterPartyId])
  @@map("proceeding_party")
}

model MatterAuthorization {
  id                String          @id @default(uuid())
  matterId          String
  powerOfAttorneyId String
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  createdById       String

  matter            Matter          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  powerOfAttorney   PowerOfAttorney @relation(fields: [powerOfAttorneyId], references: [id], onDelete: Cascade)

  @@unique([matterId, powerOfAttorneyId])
  @@index([powerOfAttorneyId])
  @@map("matter_authorization")
}

model OfficeSettings {
  id          String   @id @default("singleton")
  officeName  String
  lawyerName  String?
  phone       String?
  email       String?
  address     String?
  taxNumber   String?
  currency    String   @default("EGP")
  timeZone    String   @default("Africa/Cairo")
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String

  @@map("office_settings")
}

model Court {
  id           String       @id @default(uuid())
  name         String
  code         String?
  circuitTypes String[]     @default([])
  notes        String?
  isActive     Boolean      @default(true)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  createdById  String
  updatedById  String

  proceedings  Proceeding[]

  @@index([isActive, name])
  @@map("court")
}

model PracticeArea {
  id          String   @id @default(uuid())
  name        String
  code        String?
  notes       String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String
  updatedById String

  matters     Matter[]

  @@index([isActive, name])
  @@map("practice_area")
}

model StorageLocation {
  id          String   @id @default(uuid())
  name        String
  code        String?
  notes       String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String
  updatedById String

  matters     Matter[]

  @@index([isActive, name])
  @@map("storage_location")
}

model FileCodeSequence {
  year      Int      @id
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("file_code_sequence")
}

enum HearingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum NextDateDisposition {
  KNOWN
  NONE
  UNDETERMINED
}

enum HearingLinkRelation {
  ADJOURNED_TO
  RESCHEDULED_TO
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DeadlineStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum JobType {
  REMINDER_DELIVERY
}

enum JobRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReminderEventType {
  HEARING
  DEADLINE
  TASK
}

enum ReminderChannel {
  IN_APP
}

enum ReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model Hearing {
  id                   String         @id @default(uuid())
  proceedingId         String         @map("proceeding_id")
  hearingDate          DateTime       @db.Date @map("hearing_date")
  hearingTime          String?        @map("hearing_time")
  courtHall            String?        @map("court_hall")
  purpose              String?        @map("purpose")
  rollNumber           String?        @map("roll_number")
  status               HearingStatus  @default(SCHEDULED) @map("status")
  version              Int            @default(1) @map("version")
  rescheduleReason     String?        @map("reschedule_reason")
  cancellationReason   String?        @map("cancellation_reason")
  supersedesHearingId  String?        @map("supersedes_hearing_id")
  createdAt            DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById          String         @map("created_by_id")
  updatedById          String         @map("updated_by_id")

  proceeding           Proceeding     @relation(fields: [proceedingId], references: [id], onDelete: Cascade)
  results              HearingResult[]
  tasks                Task[]
  linksFrom            HearingLink[]  @relation("HearingLinksFrom")
  linksTo              HearingLink[]  @relation("HearingLinksTo")
  supersededBy         Hearing[]      @relation("HearingSupersedes")
  supersedesHearing    Hearing?       @relation("HearingSupersedes", fields: [supersedesHearingId], references: [id])
  documents            Document[]

  @@index([proceedingId, hearingDate])
  @@index([status, hearingDate])
  @@index([hearingDate])
  @@map("hearing")
}

model HearingResult {
  id                   String              @id @default(uuid())
  hearingId            String              @map("hearing_id")
  decisionText         String              @map("decision_text")
  summary              String?             @map("summary")
  attendance           String?             @map("attendance")
  notes                String?             @map("notes")
  correctionReason     String?             @map("correction_reason")
  nextDateDisposition  NextDateDisposition @map("next_date_disposition")
  recordedAt           DateTime            @db.Timestamptz(3) @map("recorded_at")
  revision             Int                 @default(1) @map("revision")
  supersedesResultId   String?             @map("supersedes_result_id")
  createdAt            DateTime            @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById          String              @map("created_by_id")
  updatedById          String              @map("updated_by_id")

  hearing              Hearing             @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  supersededBy         HearingResult[]     @relation("HearingResultSupersedes")
  supersedesResult     HearingResult?      @relation("HearingResultSupersedes", fields: [supersedesResultId], references: [id])

  @@index([hearingId])
  @@unique([hearingId, revision])
  @@map("hearing_result")
}

model HearingLink {
  id             String              @id @default(uuid())
  fromHearingId  String              @map("from_hearing_id")
  toHearingId    String              @map("to_hearing_id")
  relation       HearingLinkRelation @map("relation")
  createdAt      DateTime            @default(now()) @db.Timestamptz(3) @map("created_at")
  createdById    String              @map("created_by_id")

  fromHearing    Hearing             @relation("HearingLinksFrom", fields: [fromHearingId], references: [id], onDelete: Cascade)
  toHearing      Hearing             @relation("HearingLinksTo", fields: [toHearingId], references: [id], onDelete: Cascade)

  @@unique([fromHearingId, toHearingId, relation])
  @@index([fromHearingId])
  @@index([toHearingId])
  @@map("hearing_link")
}

model Task {
  id            String       @id @default(uuid())
  matterId      String?      @map("matter_id")
  proceedingId  String?      @map("proceeding_id")
  hearingId     String?      @map("hearing_id")
  deadlineId    String?      @map("deadline_id")
  title         String       @map("title")
  details       String?      @map("details")
  dueDate       DateTime?    @db.Date @map("due_date")
  dueTime       String?      @map("due_time")
  priority      TaskPriority @default(NORMAL) @map("priority")
  status        TaskStatus   @default(OPEN) @map("status")
  completedAt   DateTime?    @db.Timestamptz(3) @map("completed_at")
  completedById String?      @map("completed_by_id")
  version       Int          @default(1) @map("version")
  createdAt     DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById   String       @map("created_by_id")
  updatedById   String       @map("updated_by_id")

  matter        Matter?      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  proceeding    Proceeding?  @relation(fields: [proceedingId], references: [id], onDelete: SetNull)
  hearing       Hearing?     @relation(fields: [hearingId], references: [id], onDelete: SetNull)
  deadline      Deadline?    @relation(fields: [deadlineId], references: [id], onDelete: SetNull)

  @@index([matterId, status])
  @@index([status, dueDate])
  @@index([proceedingId])
  @@index([hearingId])
  @@index([deadlineId])
  @@map("task")
}

model Deadline {
  id                    String         @id @default(uuid())
  matterId              String         @map("matter_id")
  proceedingId          String?        @map("proceeding_id")
  title                 String         @map("title")
  dueDate               DateTime?      @db.Date @map("due_date")
  dueTime               String?        @map("due_time")
  source                String?        @map("source")
  basisNotes            String?        @map("basis_notes")
  sourceDocumentId      String?        @map("source_document_id")
  status                DeadlineStatus @default(DRAFT) @map("status")
  confirmedAt           DateTime?      @db.Timestamptz(3) @map("confirmed_at")
  confirmedById         String?        @map("confirmed_by_id")
  confirmedByName       String?        @map("confirmed_by_name")
  dateChangeReason      String?        @map("date_change_reason")
  completionDescription String?        @map("completion_description")
  completedDate         DateTime?      @db.Date @map("completed_date")
  completedAt           DateTime?      @db.Timestamptz(3) @map("completed_at")
  completedById         String?        @map("completed_by_id")
  cancellationReason    String?        @map("cancellation_reason")
  cancelledAt           DateTime?      @db.Timestamptz(3) @map("cancelled_at")
  version               Int            @default(1) @map("version")
  createdAt             DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById           String         @map("created_by_id")
  updatedById           String         @map("updated_by_id")

  matter                Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  proceeding            Proceeding?    @relation(fields: [proceedingId], references: [id], onDelete: SetNull)
  tasks                 Task[]

  @@index([status, dueDate])
  @@index([matterId, status])
  @@index([proceedingId, status])
  @@map("deadline")
}

model JobRun {
  id               String             @id @default(uuid())
  jobType          JobType            @default(REMINDER_DELIVERY) @map("job_type")
  sourceType       String             @default("Hearing") @map("source_type")
  sourceId         String             @map("source_id")
  sourceVersion    Int                @default(1) @map("source_version")
  payloadVersion   Int                @default(1) @map("payload_version")
  scheduledAt      DateTime           @db.Timestamptz(3) @map("scheduled_at")
  availableAt      DateTime           @default(now()) @db.Timestamptz(3) @map("available_at")
  nextAttemptAt    DateTime?          @db.Timestamptz(3) @map("next_attempt_at")
  leaseUntil       DateTime?          @db.Timestamptz(3) @map("lease_until")
  lockedBy         String?            @map("locked_by")
  attemptCount     Int                @default(0) @map("attempt_count")
  maxAttempts      Int                @default(5) @map("max_attempts")
  completedAt      DateTime?          @db.Timestamptz(3) @map("completed_at")
  lastError        String?            @map("last_error")
  status           JobRunStatus       @default(PENDING) @map("status")
  deduplicationKey String             @unique @map("deduplication_key")
  payload          Json               @map("payload")
  createdAt        DateTime           @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3) @map("updated_at")

  deliveries       ReminderDelivery[]

  @@index([sourceType, sourceId, status])
  @@index([status, scheduledAt])
  @@index([status, availableAt, leaseUntil])
  @@map("job_run")
}

model ReminderRule {
  id           String             @id @default(uuid())
  eventType    ReminderEventType  @map("event_type")
  dayOffset    Int                @map("day_offset")
  reminderTime String             @default("09:00") @map("reminder_time")
  channel      ReminderChannel    @default(IN_APP) @map("channel")
  enabled      Boolean            @default(true) @map("enabled")
  version      Int                @default(1) @map("version")
  createdAt    DateTime           @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3) @map("updated_at")

  deliveries   ReminderDelivery[]

  @@unique([eventType, dayOffset, channel])
  @@index([eventType, enabled])
  @@map("reminder_rule")
}

model ReminderDelivery {
  id              String                 @id @default(uuid())
  sourceType      String                 @map("source_type")
  sourceId        String                 @map("source_id")
  sourceVersion   Int                    @default(1) @map("source_version")
  ruleId          String?                @map("rule_id")
  ruleKey         String                 @map("rule_key")
  scheduledAt     DateTime               @db.Timestamptz(3) @map("scheduled_at")
  channel         ReminderChannel        @default(IN_APP) @map("channel")
  recipientUserId String                 @map("recipient_user_id")
  status          ReminderDeliveryStatus @default(PENDING) @map("status")
  title           String                 @map("title")
  body            String                 @map("body")
  matterId        String?                @map("matter_id")
  deliveredAt     DateTime?              @db.Timestamptz(3) @map("delivered_at")
  readAt          DateTime?              @db.Timestamptz(3) @map("read_at")
  jobRunId        String?                @map("job_run_id")
  createdAt       DateTime               @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3) @map("updated_at")

  rule            ReminderRule?          @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  jobRun          JobRun?                @relation(fields: [jobRunId], references: [id], onDelete: SetNull)
  matter          Matter?                @relation(fields: [matterId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId, sourceVersion, ruleKey, channel, recipientUserId], map: "reminder_delivery_source_rule_channel_recipient_key")
  @@index([recipientUserId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([matterId])
  @@map("reminder_delivery")
}

model WorkerHeartbeat {
  id            String    @id @default("reminder-worker")
  workerId      String    @map("worker_id")
  lastPollAt    DateTime  @db.Timestamptz(3) @map("last_poll_at")
  lastSuccessAt DateTime? @db.Timestamptz(3) @map("last_success_at")
  lastErrorAt   DateTime? @db.Timestamptz(3) @map("last_error_at")
  lastError     String?   @map("last_error")
  restoreMode   Boolean   @default(false) @map("restore_mode")
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@map("worker_heartbeat")
}

enum DocumentType {
  PLEADING
  MEMORANDUM
  CONTRACT
  POA_COPY
  JUDGMENT
  EVIDENCE
  RECEIPT_COPY
  CORRESPONDENCE
  ID_COPY
  OTHER
}

enum DocumentOriginalPresence {
  YES
  NO
  UNKNOWN
}

enum DocumentSensitivity {
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentVersionUploadStatus {
  UPLOADING
  QUARANTINED
  READY
  REJECTED
  FAILED
}

enum DocumentScanStatus {
  PENDING
  NOT_SCANNED_POLICY
  CLEAN
  INFECTED
  FAILED
  TIMEOUT
  STALE_DEFINITIONS
}

enum UploadAttemptStatus {
  INITIATED
  UPLOADED
  VALIDATING
  FINALIZED
  REJECTED
  FAILED
  EXPIRED
}

model Document {
  id               String                   @id @default(uuid()) @map("id")
  matterId         String?                  @map("matter_id")
  partyId          String?                  @map("party_id")
  proceedingId     String?                  @map("proceeding_id")
  hearingId        String?                  @map("hearing_id")
  title            String                   @map("title")
  titleNormalized  String                   @map("title_normalized")
  documentType     DocumentType             @map("document_type")
  documentDate     DateTime?                @db.Date @map("document_date")
  description      String?                  @map("description")
  tags             String[]                 @default([]) @map("tags")
  originalLocation String?                  @map("original_location")
  originalPresent  DocumentOriginalPresence @default(UNKNOWN) @map("original_present")
  sensitivity      DocumentSensitivity      @default(CONFIDENTIAL) @map("sensitivity")
  currentVersionId String?                  @unique @map("current_version_id")
  archivedAt       DateTime?                @db.Timestamptz(3) @map("archived_at")
  version          Int                      @default(1) @map("version")
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdById      String                   @map("created_by_id")
  updatedById      String                   @map("updated_by_id")

  matter           Matter?                  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  party            Party?                   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  proceeding       Proceeding?              @relation(fields: [proceedingId], references: [id], onDelete: SetNull)
  hearing          Hearing?                 @relation(fields: [hearingId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]        @relation("DocumentVersions")
  currentVersion   DocumentVersion?         @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  uploadAttempts   UploadAttempt[]

  @@index([matterId, createdAt])
  @@index([partyId, createdAt])
  @@index([proceedingId])
  @@index([hearingId])
  @@index([archivedAt])
  @@index([titleNormalized])
  @@map("document")
}

model DocumentVersion {
  id                 String                      @id @default(uuid()) @map("id")
  documentId         String                      @map("document_id")
  versionNumber      Int                         @map("version_number")
  objectKey          String                      @unique @map("object_key")
  originalFilename   String                      @map("original_filename")
  declaredMime       String?                     @map("declared_mime")
  detectedMime       String?                     @map("detected_mime")
  sizeBytes          Int                         @map("size_bytes")
  sha256             String?                     @map("sha256")
  uploadStatus       DocumentVersionUploadStatus @map("upload_status")
  scanStatus         DocumentScanStatus          @default(PENDING) @map("scan_status")
  scanPolicyCode     String?                     @map("scan_policy_code")
  scanPolicyVersion  String?                     @map("scan_policy_version")
  scanCheckedAt      DateTime?                   @db.Timestamptz(3) @map("scan_checked_at")
  scanError          String?                     @map("scan_error")
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3) @map("created_at")
  createdById        String                      @map("created_by_id")

  document           Document                    @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentForDocument Document?                   @relation("DocumentCurrentVersion")
  uploadAttempt      UploadAttempt?
  backupPins         BackupFilePin[]

  @@unique([documentId, versionNumber])
  @@index([sha256])
  @@index([uploadStatus, createdAt])
  @@map("document_version")
}

model UploadAttempt {
  id                      String                   @id @default(uuid()) @map("id")
  documentId              String?                  @map("document_id")
  targetDocumentVersionId String?                  @unique @map("target_document_version_id")
  idempotencyRecordId     String                   @unique @map("idempotency_record_id")
  actorId                 String                   @map("actor_id")
  matterId                String?                  @map("matter_id")
  partyId                 String?                  @map("party_id")
  proceedingId            String?                  @map("proceeding_id")
  hearingId               String?                  @map("hearing_id")
  title                   String                   @map("title")
  documentType            DocumentType             @map("document_type")
  documentDate            DateTime?                @db.Date @map("document_date")
  description             String?                  @map("description")
  tags                    String[]                 @default([]) @map("tags")
  originalLocation        String?                  @map("original_location")
  originalPresent         DocumentOriginalPresence @default(UNKNOWN) @map("original_present")
  sensitivity             DocumentSensitivity      @default(CONFIDENTIAL) @map("sensitivity")
  originalFilename        String                   @map("original_filename")
  declaredMime            String                   @map("declared_mime")
  expectedSizeBytes       Int                      @map("expected_size_bytes")
  quarantineKey           String                   @unique @map("quarantine_key")
  bytesWritten            Int                      @default(0) @map("bytes_written")
  sha256                  String?                  @map("sha256")
  status                  UploadAttemptStatus      @default(INITIATED) @map("status")
  failureReason           String?                  @map("failure_reason")
  expiresAt               DateTime                 @db.Timestamptz(3) @map("expires_at")
  finalizedAt             DateTime?                @db.Timestamptz(3) @map("finalized_at")
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3) @map("updated_at")

  document                Document?                @relation(fields: [documentId], references: [id], onDelete: SetNull)
  targetDocumentVersion   DocumentVersion?         @relation(fields: [targetDocumentVersionId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([actorId, createdAt])
  @@map("upload_attempt")
}

model BackupFilePin {
  id                String          @id @default(uuid()) @map("id")
  backupId          String          @map("backup_id")
  documentVersionId String          @map("document_version_id")
  pinnedAt          DateTime        @default(now()) @db.Timestamptz(3) @map("pinned_at")
  releasedAt        DateTime?       @db.Timestamptz(3) @map("released_at")

  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([backupId, documentVersionId])
  @@index([documentVersionId])
  @@map("backup_file_pin")
}
