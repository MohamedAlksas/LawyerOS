# LawOffice OS — Synthetic Local Environment Example (Milestone M0 / Task T02)
# Copy this file to .env.local for local development. Never commit real secrets.

# Node runtime environment (development | production | test)
NODE_ENV=development

# Server port and host binding
PORT=3000
HOST=127.0.0.1

# Operational development database URL (bound strictly to loopback 127.0.0.1)
# Note for Windows: If Hyper-V reserves 5432, use PGPORT=6432 (port 6432)
DATABASE_URL="postgresql://lawoffice_user:lawoffice_dev_secret@127.0.0.1:5432/lawoffice_dev?schema=public"

# Isolated test database URL (used by integration tests; distinct from development database)
# Note for Windows: If Hyper-V reserves 5433, use TEST_PGPORT=6433 (port 6433)
TEST_DATABASE_URL="postgresql://lawoffice_user:lawoffice_dev_secret@127.0.0.1:5433/lawoffice_test?schema=public"

# Auth secret (required starting in Task T03 for session and TOTP encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set a dedicated stable secret of at least 32 characters for Party retries.
# PARTY_IDEMPOTENCY_SECRET=
BETTER_AUTH_SECRET="synthetic_development_secret_32_bytes_minimum_length_required"
BETTER_AUTH_URL="http://127.0.0.1:3000"

# Party Identity Field Encryption Key (Task T05, AES-256-GCM 32-byte hex or base64 key)
# Out-of-band secret; never commit real keys. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARTY_IDENTITY_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PARTY_IDENTITY_KEY_ID="k2026_01"
