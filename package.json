{
  "name": "lawoffice-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test && playwright test --config=playwright.t04.config.ts && playwright test --config=playwright.t05.config.ts && playwright test --config=playwright.t06.config.ts && playwright test --config=playwright.t07.config.ts",
    "test:e2e:t03": "playwright test",
    "test:e2e:t04": "playwright test --config=playwright.t04.config.ts",
    "test:e2e:t05": "playwright test --config=playwright.t05.config.ts",
    "test:e2e:t06": "playwright test --config=playwright.t06.config.ts",
    "test:e2e:t07": "playwright test --config=playwright.t07.config.ts",
    "postinstall": "prisma generate",
    "auth:provision-owner": "tsx src/cli/provision-owner.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.20",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.20",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.23",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
